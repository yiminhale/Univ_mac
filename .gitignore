# ===== macOS 시스템 파일 =====
.DS_Store
.AppleDouble
.LSOverride
.tmp.driveupload/
.tmp.drivedownload/
._*

# ===== IDE 설정 파일 =====
.idea/
.vscode/
.claude/
.vs/
*.iml

# ===== C/C++ 빌드 결과물 =====
# 빌드 폴더
build/
cmake-build-*/
out/

# 디버그 심볼
*.dSYM/

# 오브젝트 파일
*.o
*.obj
*.lo
*.slo
*.ko
*.elf

# 라이브러리
*.a
*.lib
*.la
*.so
*.so.*
*.dylib

# 기타 빌드 결과물
*.exe
*.out
*.app

# C 컴파일 바이너리 (확장자 없음) - 소스코드(.c .h .txt .py)만 허용
# 주의: hw1/, hw2/ 같은 과제 '디렉토리'도 이 패턴에 걸린다. 부모 디렉토리가
# ignore되면 자식 파일은 negation으로 되살릴 수 없으므로, 디렉토리를 먼저 복구한 뒤
# 소스 확장자를 negation으로 허용한다. dSYM 디버그 심볼은 그 후에 다시 제외한다.
**/hw[0-9]*
!**/hw[0-9]*/
!**/hw[0-9]*.[ch]
!**/hw[0-9]*.txt
!**/hw[0-9]*.py
**/hw[0-9]*.dSYM/
**/Quiz[0-9]*
!**/Quiz[0-9]*.[ch]
**/Q[0-9]*
!**/Q[0-9]*.[ch]
**/prac
**/practice
**/calculator_*
!**/calculator_*.[ch]
**/test_*
!**/test_*.[ch]
**/analyze_*
!**/analyze_*.[ch]
**/find_all_*
!**/find_all_*.[ch]
**/pointer_array_*
!**/pointer_array_*.[ch]
**/quick_test
**/main
!**/main.[ch]
# 과제별 실행파일 (소스명과 동일, 확장자 없음)
**/struct
**/struct_v2
**/array_3d
**/drill/drill
**/reader-writer

# ===== 도구/빌드 캐시 =====
# JetBrains/기타 캐시
**/.cache/
# MATLAB/Simulink 빌드 캐시 (.slx 모델 본체는 추적, 캐시만 제외)
**/slprj/
*.slxc

# ===== Rust 빌드 =====
**/target/

# ===== 압축 파일 =====
*.zip
*.tar.gz
*.rar
*.7z

# ===== CMake 관련 =====
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
CMakeSettings.json
CMakeUserPresets.json

